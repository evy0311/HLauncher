# Optional migration address for an already-paired installation. Fresh images enroll automatically.
HLAUNCHER_RADIO_ADDRESS=00:00:00:00:00:00
HLAUNCHER_LOG_DIR=/var/log/hlauncher

# Main media audio uses the fixed HDMI output.

# Set your two-letter Wi-Fi country when building a ready-to-flash image.
# HLAUNCHER_WIFI_COUNTRY=US
