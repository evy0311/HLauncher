[Unit]
Description=HLauncher local setup and recovery
Wants=NetworkManager.service
After=local-fs.target
Before=NetworkManager.service
RequiresMountsFor=/opt/hlauncher /var/lib/hlauncher
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/hlauncher.env
WorkingDirectory=/opt/hlauncher
ExecStartPre=-/usr/bin/python3 -m hlauncher.wifi_power
ExecStart=/usr/bin/python3 -m hlauncher.recovery
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
