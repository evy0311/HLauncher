[Unit]
Description=HLauncher HDMI and HondaLink control
Wants=hlauncher-updater.service bluetooth.service hlauncher-audio.service hlauncher-connect.service hlauncher-pairing.service hlauncher-recovery.service
After=hlauncher-updater.service bluetooth.service hlauncher-audio.service hlauncher-pairing.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30
EnvironmentFile=-/etc/hlauncher.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/hlauncher
ExecStart=/usr/bin/python3 -m hlauncher run --seconds 0
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
